; Written for diffr (MIT): the grammar crate ships no highlights query.
; The keywords are the grammar's word tokens, less the names of builtin
; methods and time units.
[
  (one_line_comment)
  (block_comment)
] @comment

[
  (quoted_string)
  (triple_quoted_string)
  (string_literal)
  (dpi_spec_string)
] @string
(string_escape_seq) @string.escape

[
  (integral_number)
  (real_number)
  (unsigned_number)
  (time_literal)
  (unbased_unsized_literal)
] @number

[
  (system_tf_identifier)
  "$error"
  "$exit"
  "$fatal"
  "$finish"
  "$fullskew"
  "$hold"
  "$info"
  "$nochange"
  "$period"
  "$recovery"
  "$recrem"
  "$removal"
  "$root"
  "$setup"
  "$setuphold"
  "$skew"
  "$stop"
  "$timeskew"
  "$unit"
  "$warning"
  "$width"
] @function.builtin

[
