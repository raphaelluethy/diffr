<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>diffr: third-party licenses</title>
<style>
  :root { color-scheme: light dark; }
  body { font: 14px/1.5 -apple-system, system-ui, sans-serif; max-width: 900px; margin: 2em auto; padding: 0 16px; }
  pre { white-space: pre-wrap; background: rgba(127,127,127,.1); padding: 1em; border-radius: 6px; font-size: 12px; }
  li { margin: .1em 0; }
</style>
</head>
<body>
<h1>Third-party licenses</h1>
<p>diffr links the following Rust crates. See also NOTICE.md for the icons, queries and palettes it contains.</p>
<h2>Overview</h2>
<ul>
{{#each overview}}
  <li><a href="#{{id}}">{{name}}</a> ({{count}})</li>
{{/each}}
</ul>
<h2>License texts</h2>
{{#each licenses}}
<h3 id="{{id}}">{{name}}</h3>
<p>Used by:</p>
<ul>
{{#each used_by}}
  <li><a href="{{#if crate.repository}}{{crate.repository}}{{else}}https://crates.io/crates/{{crate.name}}{{/if}}">{{crate.name}} {{crate.version}}</a></li>
{{/each}}
</ul>
<pre>{{text}}</pre>
{{/each}}
</body>
</html>
