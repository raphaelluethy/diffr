[
  "@at-root"
  "@debug"
  "@each"
  "@else"
  "@error"
  "@extend"
  "@for"
  "@forward"
  "@function"
  "@if"
  "@import"
  "@include"
  "@media"
  "@mixin"
  "@return"
  "@supports"
  "@use"
  "@warn"
  "@while"
] @keyword
